      "expected": {"pageReturned": false, "code": "context_mismatch", "reauthorized": true}
    },
    {
      "id": "operation-retry-identical",
      "concern": "idempotency",
      "input": {"operationId": "operation_fixture_01", "normalizedPayloadDigest": "sha256:fixture-identical", "deliveryCount": 2},
      "expected": {"resourceCount": 1, "effectCount": 1, "sameReceiptReturned": true}
    },
    {
      "id": "operation-reuse-different-payload",
      "concern": "idempotency",
      "input": {"operationId": "operation_fixture_02", "firstDigest": "sha256:fixture-first", "retryDigest": "sha256:fixture-changed"},
