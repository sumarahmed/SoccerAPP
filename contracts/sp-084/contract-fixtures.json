      "input": {"localDateTime": "2026-10-04T03:30:00", "timeZone": "Australia/Sydney", "resolvedInstant": "2026-10-03T16:30:00.000Z"},
      "expected": {"localIntentPreserved": true, "resolvedInstant": "2026-10-03T16:30:00.000Z"}
    },
    {
      "id": "private-not-found",
      "concern": "error-privacy",
      "input": {
        "absent": {"resourceRef": "recording_fixture_absent"},
        "unauthorized": {"resourceRef": "recording_fixture_foreign"}
      },
      "expected": {
        "externallyIndistinguishable": true,
        "problem": {"contractVersion": "2026-09", "code": "not_found", "category": "Not found", "message": "Resource not found", "retryable": false}
      }
    },
    {
      "id": "cursor-context-revoked",
      "concern": "pagination",
