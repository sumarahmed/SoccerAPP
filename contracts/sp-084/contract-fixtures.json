{
  "fixtureSet": "sp-084-contract-fixtures-v1",
  "contractVersion": "2026-09",
  "schemaRevision": 1,
  "classification": "synthetic",
  "consumers": ["mobile", "web", "job"],
  "fixtures": [
    {
      "id": "contract-version-additive",
      "concern": "compatibility",
      "input": {
        "declaredContractVersion": "2026-09",
        "response": {"id": "player_fixture_01", "generation": 3, "displayName": "Fixture Player", "newOptionalField": "ignored"}
      },
      "expected": {"accepted": true, "knownValuesPreserved": true, "unknownResponseFieldsIgnored": ["newOptionalField"]}
    },
    {
      "id": "contract-version-breaking",
      "concern": "compatibility",
      "input": {"declaredContractVersion": "2025-01", "minimumSafeClientVersion": "2.4.0"},
